# ==============================================================================
# PEBLO TV MINI — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Connection (SQLite for dev, PostgreSQL for docker/prod)
# SQLite example: sqlite:///./peblo_dev.db
# PostgreSQL example: postgresql://peblo:peblo_password@db:5432/peblo_db
DATABASE_URL=postgresql://peblo:peblo_password@db:5432/peblo_db

# Storage Abstraction Strategy ('local' or 'r2')
STORAGE_TYPE=local
STORAGE_BASE_DIR=./storage
PUBLIC_BASE_URL=http://localhost:8000

# Cloudflare R2 / AWS S3 Storage Credentials (Used when STORAGE_TYPE=r2)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=peblo-tv-catalog

# ==============================================================================
# PRODUCTION SECRETS MANAGEMENT STRATEGY
# ==============================================================================
# In production, secrets (database credentials, R2 access keys, JWT signing keys)
# MUST NEVER be committed to source code or stored in plaintext .env files inside images.
#
# Recommended Production Practices:
# 1. Secret Vaults: Store sensitive credentials in a dedicated Secrets Manager such as
#    AWS Secrets Manager, HashiCorp Vault, or Cloudflare Environment Secrets.
# 2. Kubernetes Integration: Inject secrets into container pod environment variables using
#    External Secrets Operator (ESO) or AWS IAM Roles for Service Accounts (IRSA),
#    eliminating long-lived static credentials.
# 3. Principle of Least Privilege: Restrict R2 S3 access keys to read/write scopes on the
#    specific catalog bucket using scoped Cloudflare API tokens.
